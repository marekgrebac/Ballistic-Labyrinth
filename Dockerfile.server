FROM node:24-bookworm-slim
WORKDIR /app
COPY build/server/ballistic-labyrinth.x86_64 /app/server
RUN chmod +x /app/server
COPY manager/manager.js /app/manager.js
EXPOSE 8899
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8899/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "/app/manager.js"]
