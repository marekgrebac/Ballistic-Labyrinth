; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ballistic Labyrinth"
config/version="1.21"
run/main_scene="uid://dl53xfp6aj77b"
config/features=PackedStringArray("4.7", "Compatibility")
boot_splash/image="uid://8yxuw07nmuag"
config/icon="uid://bsnkweusjyp86"

[autoload]

NetworkManager="*uid://db3pnn8xuboou"
SessionManager="*uid://cqmpp882jy0b8"
UIManager="*uid://etejeva0swls"
IngameManager="*uid://bgrkr8b4vpemw"
MasterManager="*uid://bmre2o6yqqp4y"
ChatManager="*uid://dtud6btactpa7"
ConsoleManager="*uid://d25xxhu2th33n"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=0

[editor]

naming/script_name_casing=2

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://globals/": "gray",
"res://ingame/": "blue",
"res://ingame/entities/": "orange",
"res://ingame/entities/projectiles/": "yellow",
"res://ingame/tiles/": "red",
"res://ui/": "green"
}

[gui]

theme/custom="uid://0h4vvs6aqh51"

